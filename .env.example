# Database
DATABASE_URL=postgres://postgres@localhost:5432/shiftfocus
DATABASE_SSL=false
AUTO_MIGRATE=true
AUTO_SEED=true
PILOT_DEMO_MODE=true

# API Server
NODE_ENV=development
API_PORT=4000
CORS_ORIGIN=*
JWT_SECRET=dev-only-insecure-jwt-secret-change-me
JWT_TTL=12h

# Pilot Simulator (allowed in production when PILOT_DEMO_MODE=true)
SIMULATOR_ENABLED=true

# Background Worker & Mock EMM
WORKER_ENABLED=true
WORKER_POLL_MS=500
SWEEP_INTERVAL_MS=30000
EMM_MOCK_LATENCY_MS=250
EMM_MOCK_FAILURE_RATE=0

# Next.js Admin Console (runtime proxy target for /v1/*)
PORT=3000
API_INTERNAL_URL=http://127.0.0.1:4000

# SEO & Google Search Console (optional; defaults to https://shiftfocus-6gaz.onrender.com)
NEXT_PUBLIC_SITE_URL=https://shiftfocus-6gaz.onrender.com
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
