# Database
DATABASE_URL=postgres://postgres@localhost:5432/shiftfocus
AUTO_MIGRATE=true

# API Server
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000
JWT_SECRET=dev-only-insecure-jwt-secret-change-me
JWT_TTL=12h

# Pilot Simulator (must be false in production)
SIMULATOR_ENABLED=true

# Background Worker & Mock EMM
WORKER_ENABLED=true
WORKER_POLL_MS=500
SWEEP_INTERVAL_MS=30000
EMM_MOCK_LATENCY_MS=250
EMM_MOCK_FAILURE_RATE=0

# Next.js Admin Console
NEXT_PUBLIC_API_URL=http://localhost:4000
