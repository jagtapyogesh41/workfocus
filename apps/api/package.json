{
  "name": "@shiftfocus/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "dev": "tsc -p tsconfig.json && concurrently -k -n tsc,node \"tsc -p tsconfig.json -w --preserveWatchOutput\" \"node --watch-path=dist --enable-source-maps dist/main.js\"",
    "db:migrate": "npm run build && node dist/db/migrate-cli.js",
    "db:seed": "npm run build && node dist/db/seed.js",
    "test": "npm run build && node --test --test-concurrency=1 --enable-source-maps \"dist/**/*.test.js\"",
    "simulate": "node scripts/simulate-attendance.mjs"
  },
  "dependencies": {
    "@nestjs/common": "11.1.6",
    "@nestjs/core": "11.1.6",
    "@nestjs/platform-express": "11.1.6",
    "bcryptjs": "3.0.2",
    "express": "5.1.0",
    "jsonwebtoken": "9.0.2",
    "pg": "8.16.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "22.18.0",
    "@types/pg": "8.15.5",
    "concurrently": "9.2.1",
    "typescript": "5.9.2"
  }
}
